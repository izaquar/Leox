<t tx="AGP.20230214111049.80">def onQuit(self):    
    cc = self
  
    if cc.ACTIVE_NODE:
        cc.GoToNode(cc.ACTIVE_NODE)
        cc.aStop()
        while cc.ACTIVE_NODE:
            cc.UpdateProcess()</t>
