<t tx="AGP.20230214111049.335">def Refresh(self):
    try:
        cc = self.cc

        if (
            cc.ACTIVE_NODE and cc.DBG_PROMPT and
            cc.ACTIVE_NODE != cc.SELECTED_NODE
        ):
