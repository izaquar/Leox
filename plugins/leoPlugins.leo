<t tx="AGP.20230214111049.170">def ProgErr(self,text):
    
    #g.trace(repr(text))
    
    cc = self
    
    cc.ErrBuff += text
    lines = cc.ErrBuff.splitlines(True)
    if lines[-1][-1] != "\n" and lines[-1][-1] != "\r":
        cc.ErrBuff = lines.pop()
    else:
        cc.ErrBuff = ""
    
    text = ""	
    for l in lines:
        text += "// "+l+"\n"
    text += "# "+cc.ErrBuff
