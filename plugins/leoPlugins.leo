<t tx="AGP.20230214111049.249">def SaveObjects(self,pd=None):
    
    cc = self.cc

    if pd == None:
        pd = cc.sGet(self.name,init={})
    
    for o in self.Objects:
        pd[o.Name] = o.Get()
</t>
<t tx="AGP.20230214111049.250">def LoadObjects(self,pd=None):	

    cc = self.cc
    if pd == None:
        pd = cc.sGet(self.name,{})
        
    #g.trace(self.name,pd)
    
    for o in self.Objects:
        if o.Name not in pd:				
            pd[o.Name] = o.Get()
        else:
            o.Set(pd[o.Name])</t>
<t tx="AGP.20230214111049.251">def ClearObjects(self,value=""):
    for o in self.Objects:
        if o.Name == "Build sequence":
            o.Set("COMPILE")
        else:
            o.Set(value)</t>
<t tx="AGP.20230214111049.252">def Hide(self):
    
    cc = self.cc
    self.pack_forget()
    
    b = cc.Config.GetButton(self.name)
    b.config(relief='groove',fg=self.buttonfg)
    
    cc.LeoYBodyBar.command=cc.LeoBodyText.yview
    cc.LeoBodyText.config(yscrollcommand=cc.LeoYBodyBar.set)</t>
<t tx="AGP.20230214111049.253">def Show(self):
    
    cc = self.cc
    
    if cc.Config.ActivePage:
        cc.Config.ActivePage.Hide()
        
    cc.Config.ActivePage = self
    b = cc.Config.GetButton(self.name)
    self.buttonfg = b['fg']
    b.config(relief='sunken',fg=g.theme['accent'])	
    
    self.config(scrollregion=self.bbox('all'))
    self.config(yscrollcommand=cc.LeoYBodyBar.set)
    
    cc.LeoYBodyBar.command=self.yview
    cc.LeoYBodyBar.pack(side="right",fill="y")
    self.pack(expand=1,fill="both")
</t>
