<t tx="AGP.20230307095223.28">def init ():
     

    @others
    
    data = (
        (("new","open2"), OnCreate),
        # ("start2",      OnStart2),
        ("select2",     OnSelect2),
        #("idle",        OnIdle),
        #("command2",    OnCommand2),
        #("bodydclick2", OnBodyDoubleClick),
        #("bodykey2",    OnBodyKey2),
        ("headkey2",    OnHeadKey2),
        #("end1",        OnQuit),
    )
    
    for hook,f in data:
        leoPlugins.registerHandler(hook,f)
        
    

    g.plugin_signon(__name__)

    return True



