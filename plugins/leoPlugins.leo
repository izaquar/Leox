<t tx="AGP.20230214111049.179">def Receive(self,line):
    
    cc = self.cc
    
    if cc.DBG_PROMPT == False and line != "":
        lower = line.lower()
        if lower.find("error") &gt; -1 or lower.find("warning") &gt; -1:
            cc.aAddText(cc.CMT+line)
        else:
            if cc.OPTS["Filter output"] == "False":
                cc.aAddText("\" "+line)</t>
<t tx="AGP.20230214111049.180">class TargetPidTaskClass(DbgTaskClass):
