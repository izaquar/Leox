self.BIFILE = True
  
if cc.EXT == cc.SRC_EXT:
    self.DECLARE_IN_HDR = False
    self.BIFILE = False
    self.BOTH = self.SOURCE
    
    
if cc.EXT == cc.HDR_EXT:
    self.DEFINE_IN_SRC = False
    self.BIFILE = False
    self.BOTH = self.HEADER

if self.BIFILE:
    self.BOTH = OUTLIST(self,[h,s])
