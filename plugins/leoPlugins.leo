<t tx="edream.110203113231.894"># Sets v's body text from the file with the given name.
# Returns True if the body text changed.
def insert_read_only_node (c,v,name):
    if name=="":
        name = tkFileDialog.askopenfilename(
            title="Open",
            filetypes=[("All files", "*")]
            )
        c.beginUpdate()
        c.setHeadString(v,"@read %s" % name)
        c.endUpdate()
    parse = urlparse.urlparse(name)
    
    try:
        if parse[0] == 'ftp':
            fin = FTPurl(name)  # FTP URL
        elif parse[0] == 'http':
            fin = urllib.urlopen(name)  # HTTP URL
        else:
            fin = file(name,"r")  # local file
        
        new = fin.read()
        g.es("@read: " + name)
        fin.close()
    except IOError,msg:
        # g.es("error reading %s: %s" % (name, msg))
        g.es("@read: error reading " + name,color="red")
        c.setBodyString(v,"") # Clear the body text.
        return False # not changed
    
    else:
        ext = os.path.splitext(parse[2])[1]
        if ext.lower() in ['.htm', '.html']:
            &lt;&lt; convert HTML to text &gt;&gt;
        previous = v.t.bodyString
        c.setBodyString(v,new)
        changed = (g.toUnicode(new,'ascii') != g.toUnicode(previous,'ascii'))
        if changed and previous != "":
            g.es("changed: %s" % name) # A real change.
        return changed</t>
<t tx="edream.110203113231.895">fh = cStringIO.StringIO()
fmt = AbstractFormatter(DumbWriter(fh))
# the parser stores parsed data into fh (file-like handle)
parser = HTMLParser(fmt)

# send the HTML text to the parser
parser.feed(new)
parser.close()

# now replace the old string with the parsed text
new = fh.getvalue()
fh.close()

# finally, get the list of hyperlinks and append to the end of the text
hyperlinks = parser.anchorlist
numlinks = len(hyperlinks)
if numlinks &gt; 0:
    hyperlist = ['\n\n--Hyperlink list follows--']
    for i in xrange(numlinks):
        hyperlist.append("\n[%d]: %s" % (i+1,hyperlinks[i])) # 3/26/03: was i.
    new = new + ''.join(hyperlist)</t>
<t tx="edream.110203113231.896">#  scan the outline and process @read nodes.
def on_open(tag,keywords):
    c = keywords.get("c")
    if not c: return

    v = c.rootVnode()
    g.es("scanning for @read nodes...",color="blue")
    c.beginUpdate()
    while v:
        h = v.headString()
        if g.match_word(h,0,"@read"):
            changed = insert_read_only_node(c,v,h[6:])
            if changed:
                g.es("changing %s" % v.headString(),color="red")
                if not v.isDirty():
                    v.setDirty()
                if not c.isChanged():
                    c.setChanged(changed)
        v = v.threadNext()
    c.endUpdate()</t>
