<t tx="AGP.20230214111049.28">def init ():
    
    data = (
        (("new","open2"),   OnCreate),
        ("save1",           OnSave1),
        # ("start2",        OnStart2),
        (("select2","open2"),         OnSelect2),
        ("idle",            OnIdle),
        ("command2",        OnCommand2),
        ("bodydclick2",     OnBodyDoubleClick),
        #("bodykey2",        OnBodyKey2),
        ("headkey2",        OnHeadKey2),
        ("bodychanged",            OnBodyChanged),
        ("end1",            OnQuit),
        
    )
    
    for hook,f in data:
        leoPlugins.registerHandler(hook,f)

    g.plugin_signon(__name__)

    return True


