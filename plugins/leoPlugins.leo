<t tx="AGP.20251115191439">def GetXccKey(node,key,default=None):
    
    v = node.v
    
    ua = getattr(v,"unknownAttributes",None)
    if ua:
        xd = ua.get("xcc_cfg",None)
        if xd:
            return xd.get(key,default)
            
    return default
</t>
<t tx="AGP.20251115192354">def SetXccKey(node,key,value):
    #print "setxcckey",node
    v = node.v
    ua = getattr(v,"unknownAttributes",None)
    #print ua
    if not ua:
        ua = v.unknownAttributes = {}
    
    xd = ua.get("xcc_cfg",None)
    #print xd
    if not xd:
        xd = ua["xcc_cfg"] = {}
    
    xd[key] = value
