        self.Buffer += line
        </t>
<t tx="AGP.20230214111049.203">def OnPrompt(self):
    cc = self.cc
    
    cc.DBG_RD.remove(self.Receive)
    cc.PROMPT_RD.remove(self.OnPrompt)
    t = cc.Dasm.DasmText
        
    t.config(state='normal')        
    t.delete(1.0,'end')
        
    t.insert("insert",self.Buffer)
    
    t.config(state='disabled')
    g.es("xcmd2")

