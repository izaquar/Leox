<t tx="AGP.20230214111049.326">def OnKey(self,event=None):
    
    cc = self.cc
    
    if cc.ACTIVE_NODE:
        if len(event.char)==1 and ord(event.char) == 13:
            cc.aWrite(self.DbgEntry.get().replace("\n",""))
            self.DbgEntry.delete(0,'end')</t>
