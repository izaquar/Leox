<t tx="AGP.20230214111049.236">def __init__(self,c,n,w=500,h=100,a='nw',x=0,y=0,re=False,vs=False):#text are 3 column wide
    
    self.Name = n
    
    bg=c["bg"]
    
    self.MasterFrame = mf = Tk.Frame(c,relief='groove',bg=bg)
