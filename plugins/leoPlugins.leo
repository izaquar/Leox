<t tx="AGP.20230214111049.237">def Get(self):
    s = self.Text.get(1.0,'end')
    lines = s.splitlines()
    res = ""
    for l in lines:
        if l != "":
            res += l+"\n"
    return res
</t>
<t tx="AGP.20230214111049.238">def Set(self,text):
    self.Text.delete(1.0,'end')
    self.Text.insert('end',text)
