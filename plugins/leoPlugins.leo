elif uh:
    prms = SplitParams(params)
    dh = "&lt;font color=\"blue\"&gt;"+spec[0]+" "+ret[0]+"&lt;/font&gt; "+_as+name[0]+"("
    if prms != None:
        for t,n,a in prms:                
