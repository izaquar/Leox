<t tx="AGP.20230214111049.74">def onSelect(self):
    cc = self
    
    if cc.RUNNING: # we dont interfer with running xcc
        return
        
    p = cc.c.currentPosition()
    
    if IsXcc(p):
        cc.cSelect()
        cc.sSelect(p)        
    else:
        p2 = GetXccNode(p)
        if p2:
            if p2 != cc.SELECTED_NODE:
                cc.sSelect(p2)
            cc.cSelect(p)
            
        else:
            cc.cSelect()
            cc.sSelect()
        </t>
