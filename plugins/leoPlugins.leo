<t tx="AGP.20230307185825">def GetParentBin(self,node):
    for p in node.parents_iter():
		h = p.headString()
		if h[0:5] == "@bin ":
			return p
	
	return None</t>
<t tx="AGP.20230307185825.1">def IsAtBin(self,p):
    if p.headString()[0:5] == "@bin ":
        return True
        
    return False
