<t tx="AGP.20230214111049.323">def Go(self):    
    try:
        cc = self.cc
        
        
        if not cc.ACTIVE_NODE:
            if len(ProcessClass.List) &gt; 0 or len(cc.XCCNODES) &gt; 0:
                return Error("xcc: ","already running!")
            cc.sGo()
        elif cc.ACTIVE_NODE == cc.SELECTED_NODE:
            cc.aGo()
        else:
            Error("xcc: ",str(cc.ACTIVE_NODE)+" is already active!")            
    except Exception:
        g.es_exception()</t>
