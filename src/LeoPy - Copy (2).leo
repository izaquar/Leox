    if logCtrl:
        logCtrl['state']='normal'
        logCtrl.insert("end",'\n')
        logCtrl.see("end")
        logCtrl['state']='disabled'
        self.forceLogUpdate('\n')
    else:
        # Put a newline to logWaiting and print newline
        g.app.logWaiting.append(('\n',"black"),)
        print "Null tkinter log"
        print
