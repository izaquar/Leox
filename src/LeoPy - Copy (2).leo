<t tx="AGP.20250415230112.3721">def setEditHeadlineColors (self,p):

    c = self.c ; w = c.edit_widget(p)
    
    if self.trace and self.verbose:
        if not self.redrawing:
            print "%10s %d %s" % ("edit",id(2),p.headString())
    
    fg    = self.edithead_fg
    bg    = self.edithead_bg
    selfg = self.selecthead_fg
    selbg = self.selecthead_bg
    
    try: # Use system defaults for selection foreground/background
        w.configure(state="normal",highlightthickness=1,highlightcolor=g.theme['accent'],
        fg=fg,bg=bg,selectforeground=selfg,selectbackground=selbg)
    except:
        g.es_exception()

