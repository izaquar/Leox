<t tx="AGP.20250415230112.3720">def setDisabledHeadlineColors (self,p):

    c = self.c ; w = c.edit_widget(p)

    if self.trace and self.verbose:
        if not self.redrawing:
            g.trace("%10s %d %s" % ("disabled",id(w),p.headString()))
            # import traceback ; traceback.print_stack(limit=6)

    fg = g.theme['foreground']#c.config.getColor("headline_text_selected_foreground_color") or 
    bg = g.theme['background']#c.config.getColor("headline_text_selected_background_color") or 
    
    selfg = c.config.getColor("headline_text_editing_selection_foreground_color") or g.theme['selectbackground']
    selbg = c.config.getColor("headline_text_editing_selection_background_color") or g.theme['selectforeground']

    try:
        w.configure(state="disabled",highlightthickness=0,fg=fg,bg=bg,selectbackground=bg,selectforeground=fg,highlightbackground=bg)
    except:
        g.es_exception()
