<t tx="AGP.20251121130940">def CycleWrap(self,set=True):
    wm = self.logCtrl.cget('wrap')
    
    if wm == 'char':
        wm = 'word'
    elif wm == 'word':
        wm = 'none'
    elif wm == 'none':
        wm = 'char'
        
    if set:
        self.logCtrl.config(wrap = wm)
        
    return wm</t>
