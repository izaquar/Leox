<t tx="AGP.20250415230112.3290"># Contributed by Tomaz Ficko.  This works on some systems.
# On XP it causes a crash in tcl83.dll.  Clearly a Tk bug.

def OnMouseWheel(self, event=None):
    #print "omw"
    try:
        if event.delta &lt; 1:
            self.canvas.yview(Tk.SCROLL, 1, Tk.UNITS)
        else:
            self.canvas.yview(Tk.SCROLL, -1, Tk.UNITS)
    except:
        g.es_event_exception("scroll wheel")

    return "break"
</t>
<t tx="AGP.20250415230112.3291">def OnCanvasB2(self, event=None):
    self.lastx = event.x
    return  
</t>
<t tx="AGP.20250415230112.3292">def OnCanvasMotion(self, event=None):
    try:
        x = event.x_root    # agp        
    
        if self.lastx != -1:
            if x &lt; self.lastx:
                self.canvas.xview(Tk.SCROLL, 1, Tk.UNITS)
            elif x &gt; self.lastx:
                self.canvas.xview(Tk.SCROLL, -1, Tk.UNITS)
            else:
                return
        
        self.lastx = x
    
    except:
        g.es_event_exception("canvas motion")

    return "break"
