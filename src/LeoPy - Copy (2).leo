<t tx="AGP.20250415230112.3328"># Define the meaning of status bits in new vnodes.

# Archived...
#clonedBit   = 0x01 # True: vnode has clone mark.

# not used = 0x02
#expandedBit = 0x04 # True: vnode is expanded.
#markedBit   = 0x08 # True: vnode is marked
#orphanBit   = 0x10 # True: vnode saved in .leo file, not derived file.
#selectedBit = 0x20 # True: vnode is current vnode.
#topBit      = 0x40 # True: vnode was top vnode when saved.

# Not archived...
#dirtyBit    = 0x060
#richTextBit = 0x080 # Determines whether we use &lt;bt&gt; or &lt;btr&gt; tags.
#visitedBit  = 0x100</t>
<t tx="AGP.20250415230112.3329">@

the tree scroll line must be deduced from the past scroll fraction/linecount versus the new
new linecount past

past scroll fraction*linecount = scroll line</t>
<t tx="AGP.20250415230112.3330">def __init__(self,c,frame,parentFrame):
    
    self.frame = f = frame
    self.c = c
    
    
    Tk.Text.__init__(self,parentFrame,wrap="none",name="treetext",cursor='arrow')
    self['font'] = self.option_get('font',"leotree")
    self.font = tkFont.Font(font = self['font'])
    
    self.time = 1#None
    self.nScroll = 1
    
    self.nline = 0
    self.nlist = []
    self.currentv = None
    
    
    self.colorizer = leoColor.colorizer(c,None)
    self.colorizer.sync_tags(self)
    
    self.bind('&lt;Double-Button-1&gt;',self.void_event)
    self.bind('&lt;Motion&gt;',self.void_event)
    #self.bind('&lt;MouseWheel&gt;',self.on_mw)
    self.bind("&lt;MouseWheel&gt;",frame.TopMouseWheel)
    self.bind("&lt;Button-3&gt;",self.on_right_click)
    
    
    self.tag_bind('box',"&lt;Button-1&gt;",self.on_box_click)
    
    self.tag_bind('icon',"&lt;Button-1&gt;",self.on_icon_click)
    
    self.tag_config('head',offset=3)
    self.tag_bind('head',"&lt;Button-1&gt;",self.on_head_click)
    self.tag_bind('head',"&lt;Enter&gt;",self.on_head_enter)
    self.tag_bind('head',"&lt;Leave&gt;",self.on_head_leave)
    
    self.tag_config('cnode',background="gray20")
    self.tag_raise('cnode')
    
    self.config(state="disabled")
    
    
    logBar = g.app.gui.SCROLLBAR(parentFrame,1)#    Tk.Scrollbar(parentFrame,name="logBar")

    self['yscrollcommand'] = logBar.set
    logBar.command = self.yview
    logBar.pack(side="right", fill="y")
    
    logXBar = g.app.gui.SCROLLBAR(parentFrame,0)#Tk.Scrollbar(parentFrame,name='logXBar',orient="horizontal") 
    self['xscrollcommand'] = logXBar.set 
    logXBar.command = self.xview 
    logXBar.pack(side="bottom", fill="x")
    
    self.pack(expand=1,fill='both')
    
    
    @others
    
    #leo vars
    self.updateCount=0
    self.stayInTree = True
    self.redrawCount = 0
    self.canvas = self
    
    
