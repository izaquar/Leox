<t tx="AGP.20251130145412.6"># These are defined at http://tcl.activestate.com/man/tcl8.4/TkCmd/keysyms.htm.

# Important: only the inverse dict is actually used in the new key binding scheme.

# Tk may return the *values* of this dict in event.keysym fields.
# Leo will warn if it gets a event whose keysym not in values of this table.

tkBindNamesDict = {
    "!" : "exclam",
    '"' : "quotedbl",
    "#" : "numbersign",
    "$" : "dollar",
    "%" : "percent",
    "&amp;" : "ampersand",
    "'" : "quoteright",
    "(" : "parenleft",
    ")" : "parenright",
    "*" : "asterisk",
    "+" : "plus",
    "," : "comma",
    "-" : "minus",
    "." : "period",
    "/" : "slash",
    ":" : "colon",
    ";" : "semicolon",
    "&lt;" : "less",
    "=" : "equal",
    "&gt;" : "greater",
    "?" : "question",
    "@" : "at",
    "[" : "bracketleft",
    "\\": "backslash",
    "]" : "bracketright",
    "^" : "asciicircum",
    "_" : "underscore",
    "`" : "quoteleft",
    "{" : "braceleft",
    "|" : "bar",
    "}" : "braceright",
    "~" : "asciitilde",
}

# No translation.
for s in tkNamesList:
    tkBindNamesDict[s] = s
    
# Create the inverse dict.
tkBindNamesInverseDict = {}
for key in tkBindNamesDict.keys():
    tkBindNamesInverseDict [tkBindNamesDict.get(key)] = key
</t>
