<t tx="AGP.20250415230112.3655">def getIconImage (self, name):

    # Return the image from the cache if possible.
    if self.iconimages.has_key(name):
        return self.iconimages[name]
        
    try:
        #icons_path = g.app.config.getString(None,"icons_path") or "Icons"
        
        fullname = g.os_path_join(g.app.loadDir,"..","icons/",name)
        fullname = g.os_path_normpath(fullname)
        
        # agp icon
        
        dummy,ext = os.path.splitext(name)
        
        if ext.lower() == '.png':
            image = ImageTk.PhotoImage(Image.open(fullname))
            #image = self.open_image(fullname)
            #print "openimage"
        else:
            image = Tk.PhotoImage(master=self.canvas,file=fullname)
            print "tkimage"
        
        self.iconimages[name] = image
        return image
    except:
        #g.es("Exception loading: " + fullname)
        g.es_exception()
        return None
