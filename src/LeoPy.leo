<t tx="AGP.20250415230112.3249">def clear(self):
    
    """Destroy all the widgets in the icon bar"""
    
    f = self.iconFrame
    
    for slave in f.pack_slaves():
        slave.destroy()
    self.visible = False

    f.configure(height="30") # The default height.
    g.app.iconWidgetCount = 0
