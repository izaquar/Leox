<t tx="AGP.20250415230112.3692">def configureTextState (self,p):
    
    c = self.c
    
    if not p: return
    
    # g.trace(p.headString(),self.c._currentPosition)
    
    if c.isCurrentPosition(p):
        if p == self.editPosition():
            self.setEditLabelState(p) # selected, editing.
