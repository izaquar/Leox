<t tx="AGP.20250415230112.3723">def setHeadline (self,p,s):
    
    '''Set the actual text of the headline widget.
    
    This is called from the undo/redo logic to change the text before redrawing.'''
    
    w = self.edit_widget(p)
    if w:
        w.configure(state='normal')
        w.delete('1.0','end')
        if s.endswith('\n') or s.endswith('\r'):
            s = s[:-1]
        w.insert('1.0',s)
        self.revertHeadline = s
        # g.trace(repr(s),w.get('1.0','end'))
    else:
        g.trace('-'*20,'oops')
</t>
<t tx="AGP.20250422174312">def on_zoom(self,delta):
    
    w = self.bodyCtrl
    
    try:
        f = tkFont.Font(name=w.cget("font"))
    except:
        f = tkFont.Font(name=w.cget("font"),exists=True)
            
    fdic = f.actual()
            
    if delta &lt; 1:
        fdic['size'] += 1
    else:
        fdic['size'] -= 1
            
    w.fontref = tkFont.Font(**fdic)
    w.config(font=w.fontref)</t>
