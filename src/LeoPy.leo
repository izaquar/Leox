<t tx="AGP.20250415230112.2871">def findStartOfLine (self,lineNumber):
    
    lines = g.splitLines(self.s)
    i = 0 ; index = 0
    for line in lines:
        if i == lineNumber: break
        i += 1
        index += len(line)
    return index
</t>
<t tx="AGP.20250415230112.2872">def scanToStartOfLine (self,i):
    
    if i &lt;= 0:
        return 0
        
    assert(self.s[i] != '\n')
    
    while i &gt;= 0:
        if self.s[i] == '\n':
            return i + 1
    
    return 0
</t>
<t tx="AGP.20250415230112.2873">def scanToEndOfLine (self,i):
    
    if i &gt;= len(self.s):
        return len(self.s)
        
    assert(self.s[i] != '\n')
    
    while i &lt; len(self.s):
        if self.s[i] == '\n':
            return i - 1
    
    return i
</t>
