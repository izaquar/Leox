def getCharAtIndex (self,index):
    
    try:
        s = self.s[index]
        return g.toUnicode(s,g.app.tkEncoding)
    except: return None
    
def getTextRange (self,index1,index2):

    s = self.s[index1:index2]
    return g.toUnicode(s,g.app.tkEncoding)
