<t tx="AGP.20250415230112.3626">def setText (self,theId,t,s):
    
    """All changes to text widgets should come here."""

    if self.trace_alloc: g.trace('%4d' % (theId), self.textAddr(t),s)
            
    state = t.cget("state")
    #print state,
    if state != "normal":
        t.configure(state="normal")
    
    t.delete("1.0","end")
    t.insert("end",s)
    
    
    #print s
    if state != "normal":
        t.configure(state=state)
