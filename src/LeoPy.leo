<t tx="AGP.20250415230112.3656">def scrollTo(self,p=None):

    """Scrolls the canvas so that p is in view."""
    
    c = self.c ; frame = c.frame
    if not p or not c.positionExists(p):
        p = c.currentPosition()
    if not p or not c.positionExists(p):
        # g.trace('current p does not exist',p)
        p = c.rootPosition()
    if not p or not c.positionExists(p):
        # g.trace('no position')
        return
    
    
    try:
        last = c.lastVisible()
        nextToLast = last.visBack()
        h1 = self.yoffset(p)
        h2 = self.yoffset(last)
        &lt;&lt; compute approximate line height &gt;&gt;
        &lt;&lt; Compute the fractions to scroll down/up &gt;&gt;
        #print "scrollto",frac,lineHeight,lo,hi
        if frac &lt;= lo:
            if self.prevMoveToFrac != frac:
                self.prevMoveToFrac = frac
                self.canvas.yview("moveto",frac)
                #print "scrollto",frac
        elif frac2 + (hi - lo) &gt;= hi:
            if self.prevMoveToFrac != frac2:
                self.prevMoveToFrac = frac2
                self.canvas.yview("moveto",frac2)
                #print "scrollto",frac

        
            
        c.setTopVnode(p) # 1/30/04: remember a pseudo "top" node.
        # g.trace("%3d %3d %1.3f %1.3f %1.3f %1.3f" % (h1,h2,frac,frac2,lo,hi))
    except:
        g.es_exception()
        
idle_scrollTo = scrollTo # For compatibility.
</t>
<t tx="AGP.20250415230112.3657">if nextToLast: # 2/2/03: compute approximate line height.
    lineHeight = h2 - self.yoffset(nextToLast)
else:
    lineHeight = 20 # A reasonable default.
</t>
<t tx="AGP.20250415230112.3658">
#print self.canvas.cget("offset")
#cd = self.canvas.config()

#for k in cd.keys():
#    print cd[k]

data = frame.treeBar.get()

try: lo, hi = data
except: lo,hi = 0.0,1.0

if h2 &gt; 0.1:
    frac = float(h1)/float(h2) # For scrolling down.
    frac2 = float(h1+lineHeight/2)/float(h2) # For scrolling up.
    frac2 = frac2 - (hi - lo)
else:
    frac = frac2 = 0.0 # probably any value would work here.
    
frac =  max(min(frac,1.0),0.0)
frac2 = max(min(frac2,1.0),0.0)
