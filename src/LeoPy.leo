        &lt;&lt; compute emacs_name &gt;&gt;
            # Contains the not-so-horrible kludge.
        if emacs_name:
            commandName = emacs_name
            rawKey,accel = c.config.getShortcut(emacs_name)
            
        elif not dynamicMenu:
            #g.trace('No inverse for %s' % commandName)
            pass
