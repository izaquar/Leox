<t tx="AGP.20250415230112.3720">def setDisabledHeadlineColors (self,p):

    c = self.c ; w = c.edit_widget(p)

    if self.trace and self.verbose:
        if not self.redrawing:
            g.trace("%10s %d %s" % ("disabled",id(w),p.headString()))
            # import traceback ; traceback.print_stack(limit=6)

    fg = g.theme['foreground']#c.config.getColor("headline_text_selected_foreground_color") or 
    bg = g.theme['background']#c.config.getColor("headline_text_selected_background_color") or 
    
    selfg = c.config.getColor("headline_text_editing_selection_foreground_color") or g.theme['selectbackground']
    selbg = c.config.getColor("headline_text_editing_selection_background_color") or g.theme['selectforeground']

    try:
        w.configure(state="disabled",highlightthickness=0,fg=fg,bg=bg,selectbackground=bg,selectforeground=fg,highlightbackground=bg)
    except:
        g.es_exception()
</t>
<t tx="AGP.20250415230112.3721">def setEditHeadlineColors (self,p):

    c = self.c ; w = c.edit_widget(p)
    
    if self.trace and self.verbose:
        if not self.redrawing:
            print "%10s %d %s" % ("edit",id(2),p.headString())
    
    fg    = self.edithead_fg
    bg    = self.edithead_bg
    selfg = self.selecthead_fg
    selbg = self.selecthead_bg
    
    try: # Use system defaults for selection foreground/background
        w.configure(state="normal",highlightthickness=1,highlightcolor=g.theme['accent'],
        fg=fg,bg=bg,selectforeground=selfg,selectbackground=selbg)
    except:
        g.es_exception()

</t>
<t tx="AGP.20250415230112.3722">def setUnselectedHeadlineColors (self,p):
    
    c = self.c ; w = c.edit_widget(p)
    
    if self.trace and self.verbose:
        if not self.redrawing:
            print "%10s %d %s" % ("unselect",id(w),p.headString())
            # import traceback ; traceback.print_stack(limit=6)
    
    fg = c.config.getColor("headline_text_unselected_foreground_color") or g.theme['fg']
    bg = c.config.getColor("headline_text_unselected_background_color") or g.theme['bg']
    
    try:
        
        w.configure(state="disabled",highlightthickness=0,
        fg=fg,
        bg=bg,
        selectbackground=bg,selectforeground=fg,highlightbackground=bg)
        
    except:
        g.es_exception()
