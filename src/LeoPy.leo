<t tx="AGP.20250415230112.749">def fontSettingNameToFontKind (self,name):
    
    s = name.strip()
    if s:
        for tag in ('_family','_size','_slant','_weight'):
            if s.endswith(tag):
                return tag[1:]

    return None
