<t tx="AGP.20250415230112.3690">if p == c.currentPosition():
    
    # g.trace("is current")
    # The *second* click in the headline starts editing.
    if self.active:
        self.editLabel(p)
        returnVal = 'continue'
    else:
        # Set the focus immediately.  This is essential for proper editing.
        c.treeWantsFocusNow()
        returnVal = 'break'
else:
    
    # g.trace("not current")
    self.select(p)
    
    if c.frame.findPanel:
        c.frame.findPanel.handleUserClick(p)
    
    if p.v.t.insertSpot != None:
        c.frame.bodyCtrl.mark_set("insert",p.v.t.insertSpot)
        c.frame.bodyCtrl.see(p.v.t.insertSpot)
        
    else:
        c.frame.bodyCtrl.mark_set("insert","1.0")
    
    
    
    if self.stayInTree:
        c.treeWantsFocusNow()
    else:
        c.bodyWantsFocusNow()
    returnVal = 'break'
    
# The next click *in the same headline* will start editing.
self.active = True
